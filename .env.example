# Copie para .env APENAS na VPS. Nunca comite credenciais.
DOMAIN=visagismo.seudominio.com.br
PUBLIC_URL=https://visagismo.seudominio.com.br
VISAGISMO_IMAGE_PROVIDER=none
# Para VPS sem GPU: fal + FAL_KEY. Modelo: flux2-klein 4B edit.
FAL_KEY=
# Opcional, somente se usar um inemaimg remoto protegido:
VISAGISMO_IMAGE_URL=
VISAGISMO_PHOTO_HOURS=24
VISAGISMO_REPORT_DAYS=90
VISAGISMO_DAILY_LIMIT=50
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_SANDBOX=true
